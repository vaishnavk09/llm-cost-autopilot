# Free cloud keys — leave blank to skip a provider.
GROQ_API_KEY=
GEMINI_API_KEY=

# Local Ollama (optional). In Docker use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Set to 1 to run without any live LLM keys (deterministic mock provider).
MOCK_LLM=0

DATABASE_PATH=data/app.db
CLASSIFIER_PATH=models/complexity_clf.pkl
ROUTING_CONFIG=config/routing.yaml
MODELS_CONFIG=config/models.yaml

# Sync re-run on a higher-tier model if the first call finished under this budget (ms).
MAX_ESCALATION_MS=8000
QUALITY_FAIL_THRESHOLD=0.62
LOG_LEVEL=INFO
